# Server-local deployment settings.
#
# Copy this file to `.env` in the same directory as docker-compose.yml (on the
# server). It is gitignored, so each server can pin its own image tags.
#
# Docker Compose reads `.env` automatically for image tag interpolation.
# Tags are pushed by CI from backend/docker/IMAGE_VERSION and
# frontend/docker/IMAGE_VERSION on push to main. Set a tag here to deploy a
# specific version; leave unset to pull :latest.
BACKEND_IMAGE_VERSION=0.0.2
FRONTEND_IMAGE_VERSION=0.0.1